<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 只用于把"本机当前有没有网络"如实告诉本机引擎（措辞与是否继续等待），
         不参与任何网络访问控制；普通权限，安装时不提示（见 NetState.kt） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 用户发起的下载/数据传输：按 dataSync 工作性质评估（设计 §6.2） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileServer">

        <!-- 唯一导出组件：启动入口 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 本机服务：不导出。设计 §3 建议放私有 :server 进程做隔离，但阶段 A
             在目标设备上实测 ActivityManager 拒绝为次要进程拉起服务
             （"Unable to launch app ... process is bad"），因此阶段 A 先在
             主进程内验证内嵌 Python 能力；进程隔离留待阶段 B/D 在稳定环境复验。 -->
        <service
            android:name=".LocalServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
